[
  {
    "label": "Python: run main.py",
    "command": "venv/bin/python main.py",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Python: run current file",
    "command": "venv/bin/python \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Python: install requirements",
    "command": "venv/bin/python -m pip install -r requirements.txt",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Ruff: check project",
    "command": "ruff check .",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Ruff: fix project",
    "command": "ruff check . --fix",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Ruff: format project",
    "command": "ruff format .",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Python: pip list",
    "command": "venv/bin/python -m pip list",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
]
